[Desktop Entry]
Name=GitHubGrid
Comment=GitHub contribution grid in your KDE system tray
Exec=@INSTALL_DIR@/.venv/bin/python -m github_grid
Path=@INSTALL_DIR@
Icon=@INSTALL_DIR@/github_grid/icon.png
Type=Application
Categories=Qt;KDE;Utility;Network;
StartupNotify=false
Terminal=false
OnlyShowIn=KDE;
X-KDE-AutostartScript=false

Actions=SetupToken;

[Desktop Action SetupToken]
Name=Configure GitHub Token…
Exec=konsole -e @INSTALL_DIR@/.venv/bin/python @INSTALL_DIR@/setup-token.py
Icon=preferences-system-login
